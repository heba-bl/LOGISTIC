# ---------------------------------------------------------------------------
# Smart Logistics Control Center - environment template
# Copy to `.env` at the repository root and adjust.
# ---------------------------------------------------------------------------

# --- Service ---------------------------------------------------------------
PROJECT_NAME=Smart Logistics Control Center
SERVICE_NAME=smart-logistics-api
ENVIRONMENT=development
API_PREFIX=/api

# --- Backend server --------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- CORS (comma separated) ------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Development only: the Vite dev server falls back to another port when 5173 is
# taken. Ignored unless ENVIRONMENT is development. Leave empty to disable.
ALLOWED_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1):\d+

# --- Database --------------------------------------------------------------
# PostgreSQL is the target engine.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/smart_logistics
# If PostgreSQL is unreachable, fall back to a local SQLite file (dev only).
DATABASE_FALLBACK_SQLITE=true
SQLITE_PATH=dev.db
SQL_ECHO=false

# --- Frontend (read by Vite, must be prefixed with VITE_) -------------------
VITE_API_BASE_URL=http://127.0.0.1:8000/api
